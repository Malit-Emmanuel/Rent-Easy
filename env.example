DATABASE_URL=postgres://khp:khp@localhost:5432/khp
REDIS_URL=redis://localhost:6379
PORT=3000
# Provider selection: "fake" until each vendor passes sandbox + legal review (Risk R17)
SMS_PROVIDER=fake
PAYMENTS_PROVIDER=fake
# Auth (generate long random values; never commit real ones)
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
OTP_PEPPER=change-me-to-another-random-string-32-plus
OTP_RESEND_COOLDOWN_SEC=30
APP_ENV=development        # development | staging | production (production is blocked until real vendors exist)
# Serverless (Vercel): scheduled jobs call /internal/cron/* with this secret; unset = endpoints refuse everything
CRON_SECRET=change-me-long-random
# Browser origins allowed to call the API, comma-separated (the dashboard URL)
CORS_ORIGINS=http://localhost:3001
# Serverless: keep pools tiny; point DATABASE_URL at the provider's pooled connection string
PG_POOL_MAX=3
# Optional CA certificate text when the database requires verified TLS
DATABASE_SSL_CA=

# Railway: set REDIS_IP_FAMILY=6 only if the API cannot reach Redis over Railway's private network (verify on first deploy)
REDIS_IP_FAMILY=
